[Unit]
Description=Gunicorn daemon for Ordering System
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/Ordering_System
EnvironmentFile=/var/www/Ordering_System/.env
ExecStart=/var/www/Ordering_System/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
